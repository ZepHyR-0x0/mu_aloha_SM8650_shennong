## @file
#  Generic DWC3 USB device controller driver, ported from the reference implementation.
#
#  Provides EFI_USBFN_IO_PROTOCOL for the DWC3 instance at 0x0A600000. It replaces the
#  prebuilt Qualcomm UsbfnDwc3Dxe once the platform library below is validated.
#
#  Copyright (c) 2026. SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = UsbfnDwc3Ref
  FILE_GUID                      = 7C4A1E92-5B3D-4F86-9A17-2E8D6C0B4F51
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = InitUsbfnDwc3Driver

[Sources]
  UsbfnDwc3Dxe.c
  Dwc3Core.c
  Dwc3Endpoint.c
  PlatformUsbfnLibSm8650.c
  RpmhVrmUsb.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  QcomModulePkg/QcomModulePkg.dec
  AndromedaPkg/AndromedaPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  CacheMaintenanceLib
  DebugLib
  DxeServicesTableLib
  IoLib
  MemoryAllocationLib
  PrintLib
  SerialPortLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gEfiUsbFunctionIoProtocolGuid                 ## PRODUCES
  gEfiChipInfoProtocolGuid                      ## CONSUMES
  gEfiCpuArchProtocolGuid                       ## CONSUMES

[Depex]
  TRUE
