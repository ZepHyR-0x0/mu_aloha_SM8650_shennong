## @file
#  UsbDevStartDxe - start the DWC3 peripheral controller.
#
#  Source USB2 direct mode provides descriptors and configuration replies.
#  Hardware event/EP0 DMA is enabled by the GUI manual test; a legacy vendor
#  protocol start path remains available behind the build-time mode switch.
#
#  Copyright (c) 2026, ProjectMu shennong port.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = UsbDevStartDxe
  FILE_GUID                      = 3c81e6b2-57a4-4f19-8d60-c24b9e7a5f38
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UsbDevStartEntry

[Sources]
  UsbDevStartDxe.c
  ../../Library/WcdUsbLib/WcdUsbLib.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  QcomModulePkg/QcomModulePkg.dec
  AndromedaPkg/AndromedaPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseLib
  BaseMemoryLib
  PrintLib
  SerialPortLib
  DxeServicesTableLib
  IoLib
  TimerLib
  DebugLib

[Protocols]
  gEfiUsbDeviceProtocolGuid                     ## CONSUMES
  gEfiUsbFunctionIoProtocolGuid                 ## CONSUMES

[Guids]
  gEfiEventExitBootServicesGuid

[Depex]
  #
  # UsbDeviceDxe publishes UsbDevice; UsbfnDwc3Dxe publishes UsbfnIo.
  #
  # Waiting only on UsbDevice was not enough. This driver is an APRIORI entry, so
  # the dispatcher starts it the moment its DEPEX is satisfied - and UsbDevice
  # appears before UsbfnIo does. Every boot therefore ran the start sequence with
  # the function protocol still missing:
  #
  #   UsbDeviceOpenProtocols: Failed to locate USB FN IO protocol: Not Found
  #   [USBSTART] StartEx -> Not Found
  #   [USBSTART] Start   -> Not Found
  #
  # and BDS then reported "UsbfnIo present" a moment later, which is what made it
  # look like a USB fault rather than an ordering one.
  #
  gEfiUsbFunctionIoProtocolGuid
