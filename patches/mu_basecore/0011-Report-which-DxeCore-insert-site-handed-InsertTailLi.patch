-  if (!EFI_ERROR (Status)) {
-    CoreUpdateProfile (
-      (EFI_PHYSICAL_ADDRESS)(UINTN)RETURN_ADDRESS (0),
-      MemoryProfileActionAllocatePages,
-      MemoryType,
-      EFI_PAGES_TO_SIZE (NumberOfPages),
