-    if (EFI_ERROR (Status)) {
-      ASSERT_EFI_ERROR (Status);
-      return;
-    }
-  }
-
-  Status = CoreSetMemorySpaceAttributes (
-             0,
-             EFI_PAGES_TO_SIZE (1),
-             Desc.Attributes | EFI_MEMORY_RP
-             );
-  ASSERT_EFI_ERROR (Status);
-}
