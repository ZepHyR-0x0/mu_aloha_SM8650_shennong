-                                              ArrayOfListEntriesToBeMerged was NULL     OR
-                                              ArrayOfListEntriesToBeMerged[n] was NULL  OR
-                                              ListToBeMergedCount was zero
-  @retval Other                               Return value of OrderedInsertUint64Comparison()
