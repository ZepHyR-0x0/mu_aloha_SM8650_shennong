+  //     // If both DisableEndOfDxe and DisableReadyToBoot are enabled, just
+  //     // create the event to disable at EndOfDxe because that event is sooner
+  //     if (gDxeMps.NullPointerDetectionPolicy.Fields.DisableEndOfDxe) {
