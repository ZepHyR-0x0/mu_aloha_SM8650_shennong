-EFI_STATUS
-UnregisterMemoryProfileImage (
-  IN LOADED_IMAGE_PRIVATE_DATA  *DriverEntry
-  )
-{
-  EFI_STATUS                       Status;
-  MEMORY_PROFILE_CONTEXT_DATA      *ContextData;
-  MEMORY_PROFILE_DRIVER_INFO_DATA  *DriverInfoData;
