 }
 
+
+#ifdef SHENNONG_TOUCH_GESTURES
+STATIC BOOLEAN mPhoneDown;
+STATIC BOOLEAN mPhoneRepeat;
+STATIC BOOLEAN mPhoneIgnoreUp;
+STATIC UINTN mPhoneSpecial;
+STATIC UINT64 mPhoneShiftMs;
+
+STATIC VOID
+PhoneResetTouch (VOID)
+{
+  mPhoneDown = mPhoneRepeat = mPhoneIgnoreUp = FALSE;
+  mPhoneSpecial = 0;
+  mOSK.SelectedKey = NUMBER_OF_KEYS;
+}
+
+STATIC VOID
+PhoneCommitKey (UINTN Key)
+{
+  CHAR16 Unicode;
+  UINT16 Scan;
+  EFI_KEY EfiKey;
+  if (Key >= NUMBER_OF_KEYS) return;
+  Unicode = mOSK.pKeyMap[Key].Unicode;
+  Scan = mOSK.pKeyMap[Key].ScanCode;
+  EfiKey = mOSK.pKeyMap[Key].EfiKey;
+  if (EfiKey == EfiKeyLShift || EfiKey == EfiKeyRShift) {
+    UINT64 Now = GetTimeInNanoSecond (GetPerformanceCounter ()) / 1000000;
+    if (mOSK.KeyModifierState == Shift && Now - mPhoneShiftMs <= 500) mOSK.KeyModifierState = CapsLock;
+    else if (mOSK.KeyModifierState == Normal) mOSK.KeyModifierState = Shift;
+    else mOSK.KeyModifierState = Normal;
+    mPhoneShiftMs = Now;
+    mOSK.pKeyMap = mOSK.KeyModifierState == Normal ? mOSK_StdMode_US_EN : mOSK_ShiftMode_US_EN;
+    mOSK.bKeyboardStateChanged = TRUE;
+    return;
+  }
+  if (mOSK.pKeyMap[Key].Unicode == CHAR_BACKSPACE) {
+    InsertKeyPressIntoQueue (mOSK.pKeyMap[Key].ScanCode, CHAR_BACKSPACE);
+    return;
+  }
+  if (!KeyModifierStateMachine (EfiKey)) {
+    InsertKeyPressIntoQueue (Scan, Unicode);
+    if (mOSK.KeyModifierState == Normal) mOSK.pKeyMap = mOSK_StdMode_US_EN;
+  }
+  mOSK.bKeyboardStateChanged = TRUE;
+}
+
+STATIC VOID
+PhoneKeyboardInput (MS_SWM_ABSOLUTE_POINTER_STATE *S)
+{
+  BOOLEAN Down = SWM_IS_FINGER_DOWN (*S);
+  UINTN Key = NUMBER_OF_KEYS;
+  UINTN Special = 0;
+  EFI_STATUS Hit;
+  if (mPhoneIgnoreUp) {
+    if (!Down) mPhoneIgnoreUp = FALSE;
+    return;
+  }
+  Hit = CheckForKeyHit ((UINTN)S->CurrentX, (UINTN)S->CurrentY, &Key);
+  if (EFI_ERROR (Hit)) {
+    Key = NUMBER_OF_KEYS;
+    if (!EFI_ERROR (CheckForCloseButtonHit ((UINTN)S->CurrentX, (UINTN)S->CurrentY))) Special = 1;
+    else if (!EFI_ERROR (CheckForDockingButtonHit ((UINTN)S->CurrentX, (UINTN)S->CurrentY))) Special = 2;
+    else if (mOSK.DockedState == Undocked &&
+             !EFI_ERROR (CheckForKeyboardFrameHit ((UINTN)S->CurrentX, (UINTN)S->CurrentY))) Special = 3;
+  }
+  if (Down && !mPhoneDown) {
+    mPhoneSpecial = Special == 0 && Key == NUMBER_OF_KEYS ? 4 : Special;
+    mPhoneDown = TRUE;
+    mPhoneRepeat = FALSE;
+    mOSK.KeyboardDragOrigX = (UINTN)S->CurrentX;
+    mOSK.KeyboardDragOrigY = (UINTN)S->CurrentY;
+  }
+  if (!mPhoneDown) return;
+  if (mPhoneSpecial == 3 && Down) {
+    TranslateKeyboardLocation ((float)((INTN)S->CurrentX - (INTN)mOSK.KeyboardDragOrigX),
+                               (float)((INTN)S->CurrentY - (INTN)mOSK.KeyboardDragOrigY));
+    mOSK.KeyboardDragOrigX = (UINTN)S->CurrentX;
+    mOSK.KeyboardDragOrigY = (UINTN)S->CurrentY;
+    return;
+  }
+  if (!Down) {
+    gBS->SetTimer (mKeyRepeatTimerEvent, TimerCancel, 0);
+    if (mPhoneSpecial == 0 && Key < NUMBER_OF_KEYS && !mPhoneRepeat) PhoneCommitKey (Key);
+    else if (mPhoneSpecial == 1 && Special == 1) { ShowKeyboard (FALSE); ShowKeyboardIcon (TRUE); }
+    else if (mPhoneSpecial == 2 && Special == 2) SetKeyboardDockState (mOSK.DockedState == Docked ? Undocked : Docked);
+    else if (mPhoneSpecial == 3) Apply3DTransform (FALSE);
+    mPhoneDown = FALSE;
+    mPhoneSpecial = 0;
+    mPhoneRepeat = FALSE;
+    Key = NUMBER_OF_KEYS;
+  } else if (Key != mOSK.SelectedKey) {
+    // Sliding changes the preview only; leaving the keyboard cancels repeat.
+    gBS->SetTimer (mKeyRepeatTimerEvent, TimerCancel, 0);
+    mPhoneRepeat = FALSE;
+    if (mPhoneSpecial == 0 && Key < NUMBER_OF_KEYS && mOSK.pKeyMap[Key].Unicode == CHAR_BACKSPACE &&
+        PcdGetBool (PcdEnableTypematicOSK)) {
+      gBS->SetTimer (mKeyRepeatTimerEvent, TimerRelative, INITIAL_KEYREPEAT_INTERVAL);
+    }
+  }
+  mOSK.DeselectKey = mOSK.SelectedKey;
+  mOSK.SelectedKey = mPhoneSpecial == 0 ? Key : NUMBER_OF_KEYS;
+  if (mOSK.bDisplayKeyboard) RenderKeyboard (TRUE);
+}
+#endif
+
 VOID
 KeyboardInputHandler (
   IN MS_SWM_ABSOLUTE_POINTER_STATE  *pTouchState
@@ -2635,6 +2749,11 @@ KeyboardInputHandler (
 {
   EFI_STATUS  Status = EFI_SUCCESS;
 
+#ifdef SHENNONG_TOUCH_GESTURES
+  PhoneKeyboardInput (pTouchState);
+  return;
+#endif
+
   // Capture the touch state
   //
   BOOLEAN  bFingerDown    = ((pTouchState->ActiveButtons & 0x1) == 1);
@@ -2974,6 +3093,11 @@ OSKKeyRepeatCallback (
     return;
   }
 
+#ifdef SHENNONG_TOUCH_GESTURES
+  if (!mPhoneDown || mPhoneSpecial != 0 || mOSK.pKeyMap[KeyCount].Unicode != CHAR_BACKSPACE) return;
+  mPhoneRepeat = TRUE;
+#endif
+
   // Re-insert the last key pressed
   //
   InsertKeyPressIntoQueue (mOSK.pKeyMap[KeyCount].ScanCode, mOSK.pKeyMap[KeyCount].Unicode);
@@ -3062,6 +3186,9 @@ OSKProcessPointerCallback (
   //
   ShowKeyboardIcon (FALSE);
   ShowKeyboard (TRUE);
+#ifdef SHENNONG_TOUCH_GESTURES
+  mPhoneIgnoreUp = TRUE; // The icon-opening contact must never enter a key.
+#endif
 
   return FALSE;
 }
