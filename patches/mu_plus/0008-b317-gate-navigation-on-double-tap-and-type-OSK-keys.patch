diff --git a/MsGraphicsPkg/Include/UIToolKit/TouchGesture.h b/MsGraphicsPkg/Include/UIToolKit/TouchGesture.h
new file mode 100644
index 0000000..51fb843
--- /dev/null
+++ b/MsGraphicsPkg/Include/UIToolKit/TouchGesture.h
@@ -0,0 +1,65 @@
+/** @file Tap recognition shared by navigation controls. No clock or UI dependencies. */
+#ifndef UIT_TOUCH_GESTURE_H
+#define UIT_TOUCH_GESTURE_H
+
+typedef struct {
+  BOOLEAN Down;
+  BOOLEAN Cancelled;
+  BOOLEAN Armed;
+  UINTN Target;
+  UINTN LastTarget;
+  UINT64 DownMs;
+  UINT64 LastMs;
+  UINT64 X;
+  UINT64 Y;
+  UINT64 LastX;
+  UINT64 LastY;
+} UIT_TOUCH_GESTURE;
+
+typedef enum { UitTapNone, UitTapFocus, UitTapConfirm } UIT_TAP_RESULT;
+
+STATIC inline UINT64
+UitTouchDistance (UINT64 A, UINT64 B)
+{
+  return A > B ? A - B : B - A;
+}
+
+STATIC inline UIT_TAP_RESULT
+UitTouchTap (UIT_TOUCH_GESTURE *G, BOOLEAN Down, UINTN Target,
+             UINT64 X, UINT64 Y, UINT64 Ms, UINT64 Slop)
+{
+  if (Down) {
+    if (!G->Down) {
+      G->Down = TRUE;
+      G->Cancelled = (BOOLEAN)(Target == 0);
+      G->Target = Target;
+      G->X = X;
+      G->Y = Y;
+      G->DownMs = Ms;
+    } else if (Target != G->Target || UitTouchDistance (X, G->X) > Slop ||
+               UitTouchDistance (Y, G->Y) > Slop) {
+      G->Cancelled = TRUE;
+    }
+    return UitTapNone;
+  }
+  if (!G->Down) return UitTapNone;
+  G->Down = FALSE;
+  if (G->Cancelled || Target == 0 || Target != G->Target ||
+      UitTouchDistance (X, G->X) > Slop || UitTouchDistance (Y, G->Y) > Slop ||
+      Ms - G->DownMs > 600) {
+    G->Armed = FALSE;
+    return UitTapNone;
+  }
+  if (G->Armed && Target == G->LastTarget && Ms - G->LastMs <= 500 &&
+      UitTouchDistance (X, G->LastX) <= Slop && UitTouchDistance (Y, G->LastY) <= Slop) {
+    G->Armed = FALSE;
+    return UitTapConfirm;
+  }
+  G->Armed = TRUE;
+  G->LastTarget = Target;
+  G->LastMs = Ms;
+  G->LastX = X;
+  G->LastY = Y;
+  return UitTapFocus;
+}
+#endif
