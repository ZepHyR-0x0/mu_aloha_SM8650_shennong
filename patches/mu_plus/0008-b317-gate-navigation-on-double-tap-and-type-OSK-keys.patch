@@ -665,7 +666,7 @@ CopySettings (
 
 static
 OBJECT_STATE
-Draw (
+NativeDraw (
   IN    Canvas           *this,
   IN    BOOLEAN          DrawHighlight,                 // Ignored by canvas class since the canvas itself doesn't get highlighted (but it's part of our base class).
   IN    SWM_INPUT_STATE  *pInputState,
@@ -811,6 +812,94 @@ Exit:
 //////////////////////////////////////////////////////////////////////////////
 //
 //
+
+// Navigation actions require two complete taps on the same item. Edit boxes
+// still focus on one tap; the OSK handles text entry independently.
+static OBJECT_STATE
+Draw (Canvas *this, BOOLEAN DrawHighlight, SWM_INPUT_STATE *Input, VOID **Context)
+{
+#ifdef SHENNONG_TOUCH_GESTURES
+  UIT_CANVAS_CHILD_CONTROL *Child;
+  ControlBase *Control = NULL;
+  UINTN Target = 0;
+  UINT32 Cell = 0;
+  UINTN Index;
+  SWM_INPUT_STATE Press;
+  UIT_TAP_RESULT Tap;
+  UINT64 X, Y;
+  BOOLEAN Down;
+  BOOLEAN WasActionDown;
+  if (Context != NULL) *Context = NULL;
+  if (Input != NULL && Input->InputType == SWM_INPUT_TYPE_KEY) {
+    ZeroMem (&this->m_TouchGesture, sizeof (this->m_TouchGesture));
+  }
+  if (Input == NULL || Input->InputType != SWM_INPUT_TYPE_TOUCH)
+    return NativeDraw (this, DrawHighlight, Input, Context);
+  X = Input->State.TouchState.CurrentX;
+  Y = Input->State.TouchState.CurrentY;
+  Down = SWM_IS_FINGER_DOWN (Input->State.TouchState);
+  WasActionDown = (BOOLEAN)(this->m_TouchGesture.Down && this->m_TouchGesture.Target != 0);
+  for (Child = this->m_pControls; Child != NULL; Child = Child->pNext) {
+    SWM_RECT *B = &Child->ChildBounds;
+    ControlBase *C = (ControlBase *)Child->pControl;
+    if (Child->Invisible || C->GetControlState (C) == GRAYED ||
+        X < B->Left || X > B->Right || Y < B->Top || Y > B->Bottom) continue;
+    if (C->ControlType == BUTTON || C->ControlType == TOGGLESWITCH) {
+      Control = C;
+      Target = (UINTN)C;
+      break;
+    }
+    if (C->ControlType == LISTBOX) {
+      ListBox *L = (ListBox *)C;
+      for (Index = 0; Index < L->m_NumberOfCells; Index++) {
+        B = &L->m_pCells[Index].CellBounds;
+        if (X >= B->Left && X <= B->Right && Y >= B->Top && Y <= B->Bottom) {
+          Control = C;
+          Cell = (UINT32)Index;
+          Target = (UINTN)&L->m_pCells[Index];
+          break;
+        }
+      }
+      if (Control != NULL) break;
+    }
+  }
+  Tap = UitTouchTap (&this->m_TouchGesture, Down, Target, X, Y,
+                    GetTimeInNanoSecond (GetPerformanceCounter ()) / 1000000,
+                    MsUiScaleByTheme (24));
+  if (Control == NULL) {
+    // A release from a cancelled action gesture must never activate a new control.
+    if (WasActionDown && !Down) return NORMAL;
+    return NativeDraw (this, DrawHighlight, Input, Context);
+  }
+  if ((Down && !this->m_TouchGesture.Cancelled) || Tap == UitTapFocus) {
+    if (Control->ControlType == LISTBOX) {
+      ListBox *L = (ListBox *)Control;
+      L->m_SelectedCell = Cell;
+      L->m_HighlightedCell = Cell;
+      L->m_State = NORMAL;
+    }
+    this->SetHighlight (this, Control);
+  }
+  if (Tap != UitTapConfirm) return NORMAL;
+  // Forward one paired press/release only after confirmation. This preserves
+  // the existing control-specific callback ABI without firing on the first tap.
+  Press = *Input;
+  Press.State.TouchState.ActiveButtons |= 1;
+  NativeDraw (this, DrawHighlight, &Press, NULL);
+  {
+    OBJECT_STATE State = NativeDraw (this, DrawHighlight, Input, Context);
+    if (State == SELECT && Control->ControlType == LISTBOX) {
+      ListBox *L = (ListBox *)Control;
+      if ((L->m_Flags & UIT_LISTBOX_FLAGS_ORDERED_LIST) && L->m_LastAction == LB_ACTION_NONE)
+        L->m_LastAction = LB_ACTION_BOOT;
+    }
+    return State;
+  }
+#else
+  return NativeDraw (this, DrawHighlight, Input, Context);
+#endif
+}
+
 static
 VOID
 Ctor (
